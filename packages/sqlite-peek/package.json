{
  "name": "sqlite-peek",
  "version": "0.0.1",
  "description": "A pure JS library to read SQLite database from a Uint8Array.",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "lib"
  ],
  "author": {
    "name": "unbyte",
    "url": "https://github.com/unbyte"
  },
  "license": "MIT",
  "homepage": "https://github.com/unbyte/sqlite-peek#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbyte/sqlite-peek.git",
    "directory": "packages/sqlite-peek"
  },
  "bugs": {
    "url": "https://github.com/unbyte/sqlite-peek/issues"
  },
  "keywords": [
    "sqlite",
    "sqlite-reader",
    "uint8array"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "turbo run build"
  },
  "publishConfig": {
    "main": "lib/index.cjs",
    "module": "lib/index.mjs",
    "types": "lib/index.d.mts",
    "exports": {
      ".": {
        "import": {
          "types": "./lib/index.d.mts",
          "default": "./lib/index.mjs"
        },
        "require": {
          "types": "./lib/index.d.cts",
          "default": "./lib/index.cjs"
        }
      }
    }
  }
}
